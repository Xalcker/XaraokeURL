# Puerto del servidor
PORT=8081

# Entorno de ejecución (development o production)
NODE_ENV=development

# Secreto para las sesiones (genera uno aleatorio y seguro)
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar_por_un_secreto_aleatorio_muy_seguro

# Credenciales de Google OAuth 2.0
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
