# Puerto del servidor
PORT=8081

# Entorno de ejecución (development o production)
NODE_ENV=development

# Secreto para las sesiones (genera uno aleatorio y seguro)
# Puedes usar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar_por_un_secreto_aleatorio_muy_seguro

# Credenciales de Google OAuth 2.0 (no hacen falta si usas DISABLE_GOOGLE_AUTH)
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Desactiva el login con Google para levantar el server en local sin
# configurar credenciales de OAuth. Solo tiene efecto si NODE_ENV no es
# "production" (se ignora en producción aunque quede seteado por error).
# DISABLE_GOOGLE_AUTH=true

# Nombre que se sugiere por defecto en el control remoto cuando
# DISABLE_GOOGLE_AUTH=true está activo (opcional). Cada dispositivo puede
# elegir el suyo al unirse a la sala.
# DEV_USER_NAME=Usuario Local

# Dominio de Google Workspace permitido para iniciar sesión (opcional)
# Por defecto: xalcker.xyz
# ALLOWED_DOMAIN=xalcker.xyz

# Rutas de datos persistentes (opcional)
# Por defecto: ./karaoke.db y ./sessions en desarrollo, /data/karaoke.db y
# /data/sessions cuando NODE_ENV=production. Descomenta para sobreescribir.
# DB_PATH=/data/karaoke.db
# SESSIONS_PATH=/data/sessions

# Carpeta donde se guardan las descargas efímeras de YouTube (opcional).
# Por defecto: ./downloads en desarrollo, /data/downloads en producción.
# Requiere yt-dlp y ffmpeg instalados en el servidor (ver README).
# DOWNLOADS_PATH=/data/downloads

# Ruta al binario de yt-dlp si no está en el PATH del sistema (opcional).
# YTDLP_PATH=/usr/local/bin/yt-dlp
