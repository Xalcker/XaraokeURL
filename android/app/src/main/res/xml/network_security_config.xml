<?xml version="1.0" encoding="utf-8"?>
<!-- El servidor suele correr en la red de la casa (http://192.168.x.x:8081), sin HTTPS: se permite
     HTTP. Contra un servidor con HTTPS la app usa HTTPS igual, porque la dirección la trae el QR. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
